# Environment & API keys
.env
.env.local

# Application state (Ignore real user applications; keep repo private/clean)
state/applications/*.yaml
!state/applications/.gitkeep

# Output drafts & thread context
out/drafts/*
!out/drafts/.gitkeep
threads/*
!threads/.gitkeep

